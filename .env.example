# Copy to .env and adjust. docker compose reads this automatically.

# Public domain. The mod's default endpoint is wss://medic.dorikku.de/api.
# Only used in standalone mode (Caddy obtains the TLS certificate for it);
# in burner mode the hostname is configured on the Cloudflare tunnel instead.
DOMAIN=medic.dorikku.de

# Admin GUI account (password is synced into the DB on every startup)
GM_ADMIN_USER=admin
GM_ADMIN_PASSWORD=change-me

# Optional overrides
#GM_ROSTER_URL=https://acp.germanminer.de/public/fraction/medic
#GM_ROSTER_CACHE_SECONDS=60

# --- Deployment mode ---------------------------------------------------
# Default: alongside New-GM-API-Burner, sharing its Cloudflare tunnel.
# The app joins the burner's compose network (alias "gm-medic"); ingress is a
# second public hostname on the burner's named tunnel — see DEPLOYMENT.md:
#   medic.dorikku.de -> http://gm-medic:8765
COMPOSE_PROFILES=
COMPOSE_FILE=docker-compose.yml:docker-compose.burner.yml
# If the burner's compose network has a different name (docker network ls):
#BURNER_NETWORK=new-gm-api-burner_default

# Standalone instead (this stack's own Caddy on ports 80/443 for $DOMAIN):
# comment the two lines above and uncomment:
#COMPOSE_PROFILES=standalone
