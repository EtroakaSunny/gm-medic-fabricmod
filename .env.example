# Copy to .env and adjust. docker compose reads this automatically.

# Public domain — Caddy obtains the TLS certificate for it automatically.
# The mod's default endpoint is wss://medic.dorikku.de/api
DOMAIN=medic.dorikku.de

# Admin GUI account (password is synced into the DB on every startup)
GM_ADMIN_USER=admin
GM_ADMIN_PASSWORD=change-me

# Optional overrides
#GM_ROSTER_URL=https://acp.germanminer.de/public/fraction/medic
#GM_ROSTER_CACHE_SECONDS=60
